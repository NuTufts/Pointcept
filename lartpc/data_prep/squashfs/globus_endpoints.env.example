# copy to globus_endpoints.env (same dir) and fill in. Find UUIDs with
#   globus endpoint search "alcf#dtn_eagle"   /   globus endpoint search "Tufts"
GLOBUS_TUFTS_EP=00000000-0000-0000-0000-000000000000   # Tufts HPC collection (the one used for the dlmerged copy)
GLOBUS_EAGLE_EP=00000000-0000-0000-0000-000000000000   # alcf#dtn_eagle (paths: /eagle/neutrinoGPU/...)
