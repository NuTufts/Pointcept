# shellcheck shell=bash
# Per-sample Polaris settings: mcc9.10 Run4a BNB nu overlay (run4ovl_4a), the
# split-workflow demonstration (docs/reference/Polaris_Split_Workflow.md).
# Used as:  POL_SAMPLE_ENV=lartpc/polaris/samples/run4ovl_4a.env source lartpc/polaris/polaris_env.sh
# (polaris_env.sh sources this file right after POL_EAGLE is set; every value
# here is a ${VAR:-default} so a one-off override on the command line still wins)
export POL_SAMPLE=${POL_SAMPLE:-run4ovl_4a}
# 12 merged_sp images (run4ovl_4a_merged_sp_g00..g11.sqfs + .manifest), Globus'ed from Tufts
export POL_IMGDIR=${POL_IMGDIR:-$POL_EAGLE/data/uboone/run4ovl_4a/squashfs}
export POL_NIMG=${POL_NIMG:-12}
# stage-B outputs: lists/, logs/, tests/, kp2_images/ (per-shard squashfs + manifests)
export POL_DATADIR=${POL_DATADIR:-$POL_EAGLE/data/uboone/run4ovl_4a_stageB}
export POL_LIST_NAME=${POL_LIST_NAME:-merged_sp_run4ovl_4a_polaris.txt}
export POL_NEVENTS=${POL_NEVENTS:-103384}       # expected list length (0 = don't check)
# MC overlay, period 4: gamma proxy (mc,3)=0.8325 (no (mc,4) cell; user-approved
# 2026-10-15, same proxy as isogamma_run45), MC window 3.6-5.2 us, GT emitted
# (no --no-gt: mirrors the Tufts MC chain). --photonlib is appended by polaris_env.sh.
export POL_INF_FLAGS_SAMPLE=${POL_INF_FLAGS_SAMPLE:-"--deterministic --save-score-maps --device cuda --output-tree --gamma-run-scale 0.8325 --sample-kind mc --flash-window 3.6,5.2"}
export POL_EXPECT_GAMMA_EFF=${POL_EXPECT_GAMMA_EFF:-4.370625}   # 5.25 x 0.8325
export POL_EXPECT_SPEC=${POL_EXPECT_SPEC:-0.8325}
export POL_EXPECT_KIND=${POL_EXPECT_KIND:-mc}
export POL_EXPECT_WINDOW=${POL_EXPECT_WINDOW:-3.6,5.2}
# the CPU tail runs at Tufts (stage C): no prongCNN / sklearn checks here
export POL_NEED_TAIL=${POL_NEED_TAIL:-0}
